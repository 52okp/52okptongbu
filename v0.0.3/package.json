{
  "name": "article-sync-workbench",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "文章同步工作台 Windows 桌面测试版",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\package-win.ps1",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.articlesync.workbench",
    "productName": "文章同步工作台",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "desktop.html",
      "desktop.css",
      "desktop.js",
      "workbench.js",
      "workbench-layout.css",
      "button-layout.css",
      "panel-alignment.css",
      "sidebar-history.css",
      "styles.css",
      "assets/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "lib/**/*",
      "adapters/**/*",
      "vendor/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ArticleSyncWorkbench-${version}-Windows-${arch}-setup.${ext}",
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "installerHeaderIcon": "assets/app.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ArticleSyncWorkbench-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "assets/app.icns",
      "identity": null
    }
  }
}
